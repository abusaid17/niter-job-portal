project_id = "niter-job-portal"

[api]
enabled = true
port = 54321
schemas = ["public", "graphql_public"]
extra_search_path = ["public", "extensions"]
max_rows = 1000

[db]
port = 54322
shadow_port = 54320
major_version = 15

[studio]
enabled = true
port = 54323

[local_smtp]
enabled = true
port = 54324
user = "inbucket"
pass = "inbucket"
admin_email = "admin@email.com"
sender_name = "NITER Job Portal"

[storage]
enabled = true
file_size_limit = "5MiB"

[functions]
enabled = true
verify_jwt = true